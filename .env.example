# Server port for the MCP Orchestrator API
PORT=3001

# Default LLM Engine: auto | direct | ollama | gemini | openai
# - auto: uses Gemini if GEMINI_API_KEY is set, else OpenAI if OPENAI_API_KEY is set, else checks Ollama, else direct MCP router
# - direct: fast deterministic EN/ID natural-language -> real MCP A/B/C tool orchestrator (0ms LLM overhead)
# - ollama: local Ollama server (/api/chat with tools)
# - gemini: Google AI Studio / Gemini API
# - openai: OpenAI / OpenRouter / Groq compatible endpoint
LLM_ENGINE=auto

# Local Ollama configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=120000

# Optional Google AI Studio (Gemini) API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional OpenAI-compatible API (OpenAI / OpenRouter / Groq)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Persistence paths (optional overrides)
BOOKINGS_DB_PATH=
MEMORY_FILE_PATH=

